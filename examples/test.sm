// Actually, this is not a example - It's a code for internal
// development testing of new functionality.

type Transform = struct {
    pos: struct {
        x: i32,
        y: i32,
    },
}

fn print_i32(x: i32)

fn print_transform(t: Transform) {
    print_i32(t.pos.x)
    print_i32(t.pos.y)
}

fn get_transform() -> Transform {
    return { pos: { x: 5, z: 15 } }
}

fn main() {
    print_transform(get_transform())
}
