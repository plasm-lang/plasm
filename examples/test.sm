type Pos = struct {
    x: i32,
    y: i32,
}

fn print_32(x: i32)

fn print_pos(pos: Pos) {
    print_32(pos.x)
    print_32(pos.y)
}

fn get_pos() -> Pos {
    return { x: 5, y: 15 }
}

fn main() {
    print_pos(get_pos())
}
