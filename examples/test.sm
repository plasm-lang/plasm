// Actually, this is not a example - It's a code for internal
// development testing of new functionality.

type Transform = struct {
    pos: (F64, F64, F64)
}

fn make_transform() -> Transform {
    return { pos: (0.0, 0.0, 0.0) }
}

fn main() {
    let x = make_transform().pos.0

    // Weird-but-valid
    let a = (({ x: 1, y: 2 }.x, 2.0, true), Void).0.0
    // Expected resolution:
    // { x: 1, y: 2 }   => struct { x: I32, y: I32 }
    // _.x              => I32
    // (_, 2.0, true)   => (I32, F32, Bool)
    // (_, Void)        => ((I32, F32, Bool), Void)
    // _.0              => (I32, F32, Bool)
    // _.0              => I32
    // so `a` is I32
}
