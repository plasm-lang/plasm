// Warning: This example can't be compiled yet.
// It's written for syntax demonstration.

// Basic trait:

trait MyTrait {
    fn my_method()
}

// Implementing a trait for a type:

impl MyTrait for i32 {
    fn my_method() {
        print("i32: Hello world!")
    }
}

// Usage as generic bounds:

fn call_my_method(x: T) where T: MyTrait {
    x.my_method()
}

fn main() {
    call_my_method(42) // prints "i32: Hello world!"
}

// Traits can also be generic:

trait Add[R, O] {
    fn add(self, right: R) -> O
}

type Pos = (i32, i32)

impl Add[Pos, Pos] for Pos {
    fn add(self, right: Pos) -> Pos {
        return (self.0 + right.0, self.1 + right.1)
    }
}

// Usage:

fn sum_three(a: T, b: T, c: T) -> T where T: Add[T, T] {
    return a.add(b).add(c)
}

fn main() {
    let p1, p2, p3 = (1, 2), (3, 4), (5, 6)
    let result = sum_three(p1, p2, p3) // result is (9, 12)
}

// Dynamic dispatch:

fn sum_len(x: List[&dyn T]) -> usize where T: Len {
    let mut sum = 0
    for item in x {
        sum += item.len()
    }
    return sum
}

fn main() {
    // "hello" has length 5, ["World"] has length 1, so result is 6
    sum_len([&"hello", &["World"]])
}
