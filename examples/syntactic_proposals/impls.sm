// Warning: This example can't be compiled yet.
// It's written for syntax demonstration.

type Pos = struct {
    x: I32,
    y: I32,
}

impl Pos {
    fn new(x: I32, y: I32) -> self {
        { x, y }
    }

    fn len(&self) -> F32 {
        return sqrt(self.x * self.x + self.y * self.y)
    }
}
