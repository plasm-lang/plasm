// To write a promised (external) function that will be received on linking
// stage just don't write brackets `{}` and function body.
// C ABI/FFI will be used. Plasm has no its own public and stable ABI.

fn sum(x1: I32, x2: I32) -> I32

fn print_U8(x: U8) -> Void

fn print_I32(x: I32)
// `Void` is not necessary

fn main() {
    let x = 42
    let y = sum(x, 15)
    print_I32(y)
    print_U8(255)
}
